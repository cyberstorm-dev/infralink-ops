FROM python@sha256:57cd7c3a7a273101a6485ba99423ee568157882804b1124b4dd04266317710de

ARG BWS_VERSION=1.0.0

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list.d/debian.sources \
    && apt-get update -qq \
    && apt-get install -y -qq --no-install-recommends \
        ca-certificates \
        curl \
        git \
        gnupg \
        iptables \
        iproute2 \
        jq \
        lsb-release \
        nftables \
        openssh-client \
        ansible-core \
        unzip \
        util-linux \
        yq \
    && install -m 0755 -d /etc/apt/keyrings \
    && curl -fsSL https://download.docker.com/linux/debian/gpg \
        | gpg --dearmor -o /etc/apt/keyrings/docker.gpg \
    && chmod a+r /etc/apt/keyrings/docker.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/debian $(. /etc/os-release && echo \"$VERSION_CODENAME\") stable" \
        > /etc/apt/sources.list.d/docker.list \
    && apt-get update -qq \
    && apt-get install -y -qq --no-install-recommends docker-ce-cli docker-compose-plugin \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL "https://github.com/bitwarden/sdk/releases/download/bws-v${BWS_VERSION}/bws-x86_64-unknown-linux-gnu-${BWS_VERSION}.zip" \
        -o /tmp/bws.zip \
    && unzip -q /tmp/bws.zip -d /tmp \
    && install -m 0755 /tmp/bws /usr/local/bin/bws \
    && rm -f /tmp/bws.zip /tmp/bws

# Fixed mount targets for the private legacy-handoff transition helper.
RUN install -d \
        /infralink-host-interface/etc/infralink \
        /infralink-host-interface/etc/systemd/system \
        /infralink-host-interface/usr/libexec \
        /infralink-host-interface/usr/local/bin \
        /infralink-host-interface/usr/local/sbin

WORKDIR /app

COPY pyproject.toml README.md ./
COPY src ./src
COPY ansible ./ansible
# Resolve the published Infralink dependency declared in pyproject.toml. The
# controller exposes no public Ops console scripts; its private runtime is the
# image entrypoint and public operator calls use ``infralink``.
RUN python -m pip install --disable-pip-version-check --no-cache-dir . \
    && python -c 'from infralink import __version__; assert tuple(map(int, __version__.split("."))) >= (0, 6, 26), "infralink runtime is older than 0.6.26"'

ENTRYPOINT ["python", "-m", "infralink_ops.controller_runtime"]
